[Unit]
Description=Cat Management System
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cat-management/backend
Environment="PATH=/opt/cat-management/backend/venv/bin"
Environment="DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cat_management"
Environment="BARK_KEY=your_bark_key_here"
Environment="BARK_SERVER=https://api.day.app"
ExecStart=/opt/cat-management/backend/venv/bin/gunicorn app.main:app -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
